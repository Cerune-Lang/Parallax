// Parallax: deterministic fixed/dynamic array ownership and bounds corpus.
// Protocol v1: version, count, then seven decimal fields per case:
// representation (0 = fixed [i64;3], 1 = dynamic [i64]),
// mode (0 = original update, 1 = saved update, 2 = valid read,
//       3 = negative read, 4 = too-large read, 5 = negative write,
//       6 = too-large write, 7 = valid write with trapping RHS),
// first, second, third, replacement, index.
//
// Fixed seed; all calculations are bounded i64. No filesystem/process access.
mut state: i64 = 20261019;
mut i: i64 = 0;
print(1);
print(32);
while i < 32 {
    kind: i64 = (i / 8) % 2;
    mode: i64 = i % 8;

    state = (state * 48271) % 2147483647;
    first: i64 = state % 81 - 40;
    state = (state * 48271) % 2147483647;
    second: i64 = state % 81 - 40;
    state = (state * 48271) % 2147483647;
    third: i64 = state % 81 - 40;
    state = (state * 48271) % 2147483647;
    replacement: i64 = state % 101 + 100;
    state = (state * 48271) % 2147483647;
    mut index: i64 = state % 3;

    if mode == 3 || mode == 5 {
        index = -1;
    }
    if mode == 4 || mode == 6 {
        index = 3;
    }

    print(kind);
    print(mode);
    print(first);
    print(second);
    print(third);
    print(replacement);
    print(index);
    i = i + 1;
}
